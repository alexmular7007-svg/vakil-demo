{
  "name": "vaakil-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server scripts/migrate.ts",
    "db:seed": "tsx --conditions=react-server scripts/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:check": "tsx --conditions=react-server scripts/db-check.ts",
    "judgments:import": "tsx --conditions=react-server scripts/judgments/import.ts",
    "updates:sync": "tsx --conditions=react-server scripts/updates/sync.ts",
    "updates:check": "tsx --conditions=react-server scripts/updates/sync.ts --dry-run",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:serve": "node scripts/db-server.mjs",
    "setup": "node scripts/setup.mjs",
    "local": "node scripts/local.mjs",
    "local:prod": "node scripts/local.mjs --prod"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@electric-sql/pglite": "^0.5.14",
    "@google/genai": "^2.32.0",
    "better-auth": "^1.7.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.15.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.66.0",
    "mammoth": "^1.13.0",
    "next": "16.4.4",
    "next-themes": "^0.4.6",
    "nodemailer": "^8.0.11",
    "pdf-lib": "^1.17.1",
    "postgres": "^4.0.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "unpdf": "^2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "^18.6.0-beta.19",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
