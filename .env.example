# Copy to .env.local and fill in. Never commit real keys.

APP_URL=http://localhost:3000

# --- Database -------------------------------------------------------------
# Local: start PostgreSQL with `npm run db:serve`, then use the URL below.
# Production: the vaakil.com Supabase project (Mumbai), connecting as a role
# that is a member of app_user (see src/lib/db/sql/security.sql).
# (If left empty, a single-process embedded PGlite in .data/pglite is used.)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/vaakil

# --- Auth -----------------------------------------------------------------
# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=

# --- AI (either or both) ---------------------------------------------------
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# auto | anthropic | google
AI_PROVIDER=auto
# Everything below is optional: leave empty to use the defaults in src/lib/ai/config.ts.
# With AI_PROVIDER=auto and both keys, a failing provider fails over to the other (true | false).
AI_FAILOVER=
# Model ids per tier. Defaults: claude-haiku-5-5 / claude-sonnet-5-5 / claude-opus-5-5,
# gemini-3.5-flash-lite / gemini-3.8-flash / gemini-3.1-pro-preview.
AI_MODEL_CLAUDE_FAST=
AI_MODEL_CLAUDE_STANDARD=
AI_MODEL_CLAUDE_PRO=
AI_MODEL_GEMINI_FAST=
AI_MODEL_GEMINI_STANDARD=
AI_MODEL_GEMINI_PRO=
# (Older names for the Gemini overrides, still honoured: GEMINI_FAST_MODEL, GEMINI_STANDARD_MODEL, GEMINI_PRO_MODEL.)
# Claude effort per tier: low | medium | high | xhigh | max (defaults low / medium / high)
AI_EFFORT_FAST=
AI_EFFORT_STANDARD=
AI_EFFORT_PRO=
# Output-token ceiling per tier (defaults 16000 / 16000 / 32000)
AI_MAX_TOKENS_FAST=
AI_MAX_TOKENS_STANDARD=
AI_MAX_TOKENS_PRO=
# Tier per kind of chat request: fast | standard | pro (defaults standard / pro / pro / fast)
AI_TIER_CHAT=
AI_TIER_DEEP=
AI_TIER_DRAFT=
AI_TIER_TITLE=
# Abort an attempt when the provider sends nothing for this long, ms (default 90000)
AI_TIMEOUT_MS=
# Hard cap for one answer including retries and failover, ms (default 270000)
AI_DEADLINE_MS=
# Retries per provider for 429 / 5xx / network / timeout before any text was sent (default 2),
# exponential backoff with jitter between AI_RETRY_BASE_MS (500) and AI_RETRY_MAX_MS (8000)
AI_MAX_RETRIES=
AI_RETRY_BASE_MS=
AI_RETRY_MAX_MS=
# Circuit breaker per provider: open after N consecutive failures (5), probe again after (30000) ms
AI_BREAKER_THRESHOLD=
AI_BREAKER_COOLDOWN_MS=
# Retrieval: sources per answer (6 statutes, 4 judgment paragraphs, 4 document parts) and the
# longest text kept per source, cut at a sentence boundary (2400 characters)
AI_RETRIEVAL_STATUTES=
AI_RETRIEVAL_JUDGMENTS=
AI_RETRIEVAL_DOCUMENTS=
AI_SOURCE_MAX_CHARS=
# Context budget in estimated tokens: whole prompt (48000), the sources block (12000),
# and how many earlier messages are loaded as history (20)
AI_CONTEXT_BUDGET_TOKENS=
AI_SOURCE_BUDGET_TOKENS=
AI_HISTORY_MESSAGES=

# --- Email ----------------------------------------------------------------
# Sign in with Google: create an OAuth client (type "Web application") at
# https://console.cloud.google.com/apis/credentials and add this redirect URI:
#   http://localhost:3000/api/auth/callback/google   (and your live domain's equivalent)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email: either Resend, or SMTP (for example your Gmail with an app password:
# Google Account > Security > 2-Step Verification > App passwords).
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Vaakil AI <no-reply@vaakil.com>"

# --- Files ----------------------------------------------------------------
FILE_STORAGE_DIR=.data/uploads
MAX_UPLOAD_MB=15

# --- CGPEY (KYC + payments) ------------------------------------------------
CGPEY_BASE_URL=https://api.cgpey.com
CGPEY_MERCHANT_ID=
CGPEY_API_KEY=
CGPEY_API_SECRET=
CGPEY_WEBHOOK_SECRET=

# --- Aadhaar eSign through a licensed aggregator ---------------------------
# none | leegality | digio | signdesk | emsigner | zoho | setu
ESIGN_PROVIDER=none
ESIGN_API_KEY=
ESIGN_WEBHOOK_SECRET=

# --- search.vaakil.com company directory (read-only) ------------------------
DIRECTORY_SUPABASE_URL=
DIRECTORY_SUPABASE_KEY=

# --- Legal updates ----------------------------------------------------------
# Long random string; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>"
# to /api/cron/updates (every 6 hours, see vercel.json). Generate: openssl rand -hex 32
CRON_SECRET=
# Optional extra RSS/Atom feeds to watch, comma-separated https URLs.
EXTRA_UPDATE_FEEDS=
# Optional: source keys to switch off without a code change, comma-separated.
# Keys: sansad-bills, prs-billtrack, indiankanoon-sc, scc-times, india_code;
# "extra:*" switches off every EXTRA_UPDATE_FEEDS feed. /admin/updates lists the keys.
DISABLED_UPDATE_SOURCES=

# --- Local admin created by `npm run db:seed` (development only) -----------
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
